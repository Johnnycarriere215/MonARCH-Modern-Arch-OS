#!monarch-template
#!target: btop/themes/monarch.theme
#!
#! No reload command: btop re-reads its theme on restart and has no IPC.
#! config/btop/btop.conf pins color_theme = "monarch", so the file below is
#! always the one in use and the theme name never changes — only its contents.
# GENERATED BY MONARCH — DO NOT EDIT
#
# Theme: {{meta.name}} by {{meta.author}}
# Regenerate with: monarch theme apply <name>
#
# btop gradients are given as start/mid/end and interpolated by btop itself.

theme[main_bg]="{{ui.bg}}"
theme[main_fg]="{{ui.fg}}"
theme[title]="{{ui.fg}}"
theme[hi_fg]="{{ui.accent}}"
theme[selected_bg]="{{ui.selection_bg}}"
theme[selected_fg]="{{ui.selection_fg}}"
theme[inactive_fg]="{{ui.fg_faint}}"
theme[graph_text]="{{ui.fg_dim}}"
theme[meter_bg]="{{ui.surface}}"
theme[proc_misc]="{{ui.accent_alt}}"

theme[cpu_box]="{{ui.overlay}}"
theme[mem_box]="{{ui.overlay}}"
theme[net_box]="{{ui.overlay}}"
theme[proc_box]="{{ui.overlay}}"
theme[div_line]="{{ui.overlay}}"

theme[temp_start]="{{sem.ok}}"
theme[temp_mid]="{{sem.warning}}"
theme[temp_end]="{{sem.urgent}}"

theme[cpu_start]="{{sem.ok}}"
theme[cpu_mid]="{{ui.accent}}"
theme[cpu_end]="{{sem.urgent}}"

theme[free_start]="{{sem.ok}}"
theme[free_mid]="{{term.cyan}}"
theme[free_end]="{{term.blue}}"

theme[cached_start]="{{term.cyan}}"
theme[cached_mid]="{{term.blue}}"
theme[cached_end]="{{ui.accent}}"

theme[available_start]="{{sem.warning}}"
theme[available_mid]="{{ui.accent_alt}}"
theme[available_end]="{{sem.urgent}}"

theme[used_start]="{{sem.ok}}"
theme[used_mid]="{{sem.warning}}"
theme[used_end]="{{sem.urgent}}"

theme[download_start]="{{term.cyan}}"
theme[download_mid]="{{term.blue}}"
theme[download_end]="{{ui.accent}}"

theme[upload_start]="{{sem.warning}}"
theme[upload_mid]="{{ui.accent_alt}}"
theme[upload_end]="{{sem.urgent}}"

theme[process_start]="{{sem.ok}}"
theme[process_mid]="{{sem.warning}}"
theme[process_end]="{{sem.urgent}}"
