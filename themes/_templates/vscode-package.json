#!monarch-template
#!target: ~/.vscode/extensions/monarch-theme/package.json
#!
#! VS Code cannot include a colour file the way Hyprland or Waybar can — the
#! only two ways in are workbench.colorCustomizations in settings.json, which
#! would mean merging JSON (no parser available under golden rule 6), or an
#! installed theme extension. So MonARCH generates a real, if minimal,
#! extension: this manifest plus vscode-theme.json beside it.
#!
#! Two files for one app does not break "adding an app is adding one template"
#! — it needs no code change either way. It is VS Code's shape, not ours.
#!
#! The extension is always called "MonARCH" and the palette inside it changes,
#! so the user picks the theme once and never touches it again. Setting
#! workbench.colorTheme automatically is T8's job, in the VS Code installer
#! that already has to edit settings.json.
{
  "name": "monarch-theme",
  "displayName": "MonARCH",
  "description": "The active MonARCH theme ({{meta.name}}). Regenerated by: monarch theme apply",
  "version": "1.0.0",
  "publisher": "monarch",
  "engines": { "vscode": "^1.70.0" },
  "categories": ["Themes"],
  "contributes": {
    "themes": [
      {
        "label": "MonARCH",
        "uiTheme": "{{meta.vscode_ui}}",
        "path": "./themes/monarch-color-theme.json"
      }
    ]
  }
}
