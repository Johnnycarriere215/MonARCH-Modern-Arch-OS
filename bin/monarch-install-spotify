#!/usr/bin/env bash
#DESC: Install Spotify

set -euo pipefail

_src=${BASH_SOURCE[0]}
while [[ -L "$_src" ]]; do
  _dir=$(cd -P "$(dirname "$_src")" && pwd); _src=$(readlink "$_src")
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
MONARCH_HOME=${MONARCH_HOME:-$(cd -P "$(dirname "$_src")/.." && pwd)}
# shellcheck source=/dev/null
source "$MONARCH_HOME/bin/_lib.sh"
# shellcheck source=/dev/null
source "$MONARCH_HOME/bin/_install-lib.sh"

usage() {
  cat <<'END'
Install Spotify.

Usage:
  monarch install spotify

Not redistributable, so it is never bundled in the ISO (golden rule 7) — this
fetches it on your machine at install time.
END
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") ;;
  *) err "unknown argument: $1"; exit 1 ;;
esac

# The spotify PKGBUILD verifies the download against Spotify's signing key,
# which is in nobody's keyring by default. Without it the build fails on a
# fresh machine with a gpg error that reads like a broken package rather than
# like a missing key — so import it first.
#
# Unconditional rather than checked: gpg --import is idempotent, and checking
# would mean hardcoding a key id that Spotify rotates.
if ! pkg_installed spotify; then
  step "importing Spotify's signing key (the PKGBUILD verifies against it)"
  curl -fsSL https://download.spotify.com/debian/pubkey_C85668DF69375001.gpg 2>/dev/null \
    | gpg --import - >/dev/null 2>&1 \
    || warn "could not import the signing key — the build may fail its signature check"
fi

aur_install spotify "Spotify"
