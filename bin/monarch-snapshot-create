#!/usr/bin/env bash
#DESC: Take a Btrfs snapshot of the root filesystem

set -euo pipefail

_src=${BASH_SOURCE[0]}
while [[ -L "$_src" ]]; do
  _dir=$(cd -P "$(dirname "$_src")" && pwd); _src=$(readlink "$_src")
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
MONARCH_HOME=${MONARCH_HOME:-$(cd -P "$(dirname "$_src")/.." && pwd)}
# shellcheck source=/dev/null
source "$MONARCH_HOME/bin/_lib.sh"

usage() {
  cat <<'EOF'
Take a Btrfs snapshot of / before something changes it.

Usage:
  monarch snapshot create [description] [--required]

  --required   exit 1 if the snapshot cannot be taken

`monarch update` calls this FIRST, always, with --required. Golden rule: never
auto-apply an update without a snapshot first. A snapshot that silently did not
happen is worse than an update that refused to start.

Snapshots are snapper's, in the 'root' config, and Limine is configured to boot
them — so a bad update is recoverable from the boot menu rather than from a
live USB.
EOF
}

DESC=""
REQUIRED=false

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)  usage; exit 0 ;;
      --required) REQUIRED=true ;;
      -*) err "unknown option: $1"; exit 1 ;;
      *)  DESC=${DESC:+$DESC }$1 ;;
    esac
    shift
  done

  [[ -n "$DESC" ]] || DESC="monarch $(date +%Y-%m-%d\ %H:%M)"

  fail() {
    if [[ "$REQUIRED" == true ]]; then
      err "$1"
      exit 1
    fi
    warn "$1"
    exit 0
  }

  have snapper || fail "snapper is not installed — no snapshot taken"

  # A machine whose root is not Btrfs cannot be snapshotted, and bootstrap.sh
  # refuses to install on one — so this only fires if something changed
  # underneath us.
  local fstype
  fstype=$(findmnt -no FSTYPE / 2>/dev/null || printf 'unknown')
  [[ "$fstype" == "btrfs" ]] || fail "/ is $fstype, not btrfs — no snapshot taken"

  snapper -c root list >/dev/null 2>&1 \
    || fail "snapper has no 'root' config — run: sudo snapper -c root create-config /"

  info "Snapshotting /"

  local num
  # --print-number so the number can be reported: it is what you type at the
  # Limine menu, and what `monarch snapshot restore` takes.
  num=$(sudo snapper -c root create --type single --cleanup-algorithm number \
    --description "$DESC" --print-number 2>/dev/null) \
    || fail "snapper refused to create a snapshot"

  ok "snapshot #$num — $DESC"
  printf '%s\n' "$num" >"$MONARCH_STATE_DIR/last-snapshot" 2>/dev/null || true
}

mkdir -p "$MONARCH_STATE_DIR" 2>/dev/null || true
main "$@"
