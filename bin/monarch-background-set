#!/usr/bin/env bash
#DESC: Set the wallpaper

set -euo pipefail

_src=${BASH_SOURCE[0]}
while [[ -L "$_src" ]]; do
  _dir=$(cd -P "$(dirname "$_src")" && pwd); _src=$(readlink "$_src")
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
MONARCH_HOME=${MONARCH_HOME:-$(cd -P "$(dirname "$_src")/.." && pwd)}
# shellcheck source=/dev/null
source "$MONARCH_HOME/bin/_lib.sh"
# shellcheck source=/dev/null
source "$MONARCH_HOME/bin/_theme-lib.sh"

usage() {
  cat <<'EOF'
Set the desktop wallpaper.

Usage:
  monarch background set <image>
  monarch background set --none

  --none   no wallpaper: the desktop falls back to the theme's background colour

The image is applied immediately through hyprpaper's IPC and written to
~/.config/hypr/hyprpaper.conf so it survives a reboot. That file is generated
— edit it and the next call overwrites you.

MonARCH ships no wallpapers. Every image needs a recorded licence; see the
README in any theme's backgrounds/ directory.
EOF
}

HYPRPAPER_CONF="$MONARCH_CONFIG_DIR/hypr/hyprpaper.conf"
STATE_FILE="$MONARCH_STATE_DIR/background"

write_conf() {
  local image=${1:-}
  mkdir -p "$(dirname "$HYPRPAPER_CONF")"

  {
    printf '# GENERATED BY MONARCH — DO NOT EDIT\n#\n'
    printf '# Regenerate with: monarch background set <image>\n#\n'
    printf '# ipc must stay on: monarch background set|next change the wallpaper\n'
    printf '# live through it rather than restarting hyprpaper.\n\n'
    printf 'ipc = on\nsplash = false\n'
    if [[ -n "$image" ]]; then
      printf '\npreload = %s\nwallpaper = , %s\n' "$image" "$image"
    else
      printf '\n# No wallpaper set.\n'
    fi
  } >"$HYPRPAPER_CONF.monarch-tmp"

  mv -f "$HYPRPAPER_CONF.monarch-tmp" "$HYPRPAPER_CONF"
}

apply_live() {
  local image=${1:-}

  # Nothing to talk to outside a session, and that is fine: hyprpaper reads the
  # config we just wrote when it next starts.
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 0
  have hyprctl || return 0
  pgrep -x hyprpaper >/dev/null 2>&1 || return 0

  if [[ -z "$image" ]]; then
    hyprctl hyprpaper unload all >/dev/null 2>&1 || true
    return 0
  fi

  hyprctl hyprpaper preload "$image" >/dev/null 2>&1 || {
    warn "hyprpaper could not load that image — it will be tried again next login"
    return 0
  }
  hyprctl hyprpaper wallpaper ",$image" >/dev/null 2>&1 || true
  # Free every image except the one now on screen.
  hyprctl hyprpaper unload unused >/dev/null 2>&1 || true
}

main() {
  local image=""

  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --none)
      write_conf ""
      apply_live ""
      mkdir -p "$MONARCH_STATE_DIR"
      : >"$STATE_FILE"
      ok "wallpaper cleared"
      exit 0
      ;;
    "") err "which image?"; printf '\n'; usage >&2; exit 1 ;;
    -*) err "unknown option: $1"; exit 1 ;;
    *)  image=$1 ;;
  esac

  [[ -f "$image" ]] || die "no such file: $image"
  image=$(cd -P "$(dirname "$image")" && printf '%s/%s' "$(pwd)" "$(basename "$image")")

  case "${image,,}" in
    *.jpg|*.jpeg|*.png|*.webp) ;;
    *) die "hyprpaper reads jpg, jpeg, png and webp — not $(basename "$image")" ;;
  esac

  have hyprpaper || warn "hyprpaper is not installed — recording this anyway"

  write_conf "$image"
  apply_live "$image"

  mkdir -p "$MONARCH_STATE_DIR"
  printf '%s\n' "$image" >"$STATE_FILE"

  ok "wallpaper: ${image/#$HOME/\~}"
}

main "$@"
