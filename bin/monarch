#!/usr/bin/env bash
#DESC: The MonARCH command line — dispatches to monarch-* scripts
#
# The only thing in MonARCH that writes configuration. The settings GUI shells
# out to this; it never touches a config file itself (golden rule 1).
#
# Dispatch:
#   monarch <group> <verb>   ->  bin/monarch-<group>-<verb>
#   monarch <verb>           ->  bin/monarch-<verb>
#   monarch                  ->  grouped help, discovered by scanning bin/
#
# Nothing about the command list is hardcoded. Dropping a new executable named
# monarch-<something> into bin/ makes it a command, and it appears in help as
# long as it carries a '#DESC:' line.

set -euo pipefail

# ------------------------------------------------------------------ layout ---

resolve_self() {
  local src=${BASH_SOURCE[0]}
  # bin/monarch is symlinked into ~/.local/bin, so follow links to find the
  # real repo checkout.
  while [[ -L "$src" ]]; do
    local dir; dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

BIN_DIR=$(resolve_self)
MONARCH_HOME=${MONARCH_HOME:-$(cd "$BIN_DIR/.." && pwd)}
export MONARCH_HOME

# ------------------------------------------------------------------ output ---

if [[ -t 1 ]]; then
  C_RESET=$'\e[0m'; C_BOLD=$'\e[1m'; C_DIM=$'\e[2m'; C_RED=$'\e[31m'; C_CYAN=$'\e[36m'
else
  C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""; C_CYAN=""
fi

err() { printf '%serror:%s %s\n' "$C_RED$C_BOLD" "$C_RESET" "$*" >&2; }

# --------------------------------------------------------------- discovery ---

# All command names, one per line, without the 'monarch-' prefix.
discover_commands() {
  local f name
  for f in "$BIN_DIR"/monarch-*; do
    [[ -f "$f" && -x "$f" ]] || continue
    name=$(basename "$f")
    printf '%s\n' "${name#monarch-}"
  done | sort
}

# The one-line description a script advertises via '#DESC: ...'.
describe() {
  local file="$BIN_DIR/monarch-$1"
  local line
  line=$(grep -m1 '^#DESC:' "$file" 2>/dev/null || true)
  if [[ -n "$line" ]]; then
    printf '%s' "${line#\#DESC:}" | sed 's/^[[:space:]]*//'
  else
    printf '%s' "-"
  fi
}

# A first token is a group when at least two commands share it AND use it as a
# prefix followed by a verb. 'theme-apply' + 'theme-list' make a 'theme' group;
# a lone 'doctor' stays a bare verb.
group_of() { printf '%s' "${1%%-*}"; }

is_group() {
  local candidate=$1 count=0 c
  while IFS= read -r c; do
    [[ "$c" == "$candidate-"* ]] && count=$((count + 1))
  done < <(discover_commands)
  [[ $count -ge 2 ]]
}

# ------------------------------------------------------------------- help ---

print_help() {
  local version="?"
  [[ -r "$MONARCH_HOME/version" ]] && version=$(<"$MONARCH_HOME/version")

  printf '%sMonARCH%s %s\n\n' "$C_BOLD" "$C_RESET" "$version"
  printf 'Usage:\n'
  printf '  monarch <group> <verb> [args]\n'
  printf '  monarch <verb> [args]\n\n'

  local commands=() c
  while IFS= read -r c; do commands+=("$c"); done < <(discover_commands)

  if [[ ${#commands[@]} -eq 0 ]]; then
    printf '  No commands found in %s\n' "$BIN_DIR"
    return 0
  fi

  # Work out which first tokens are real groups, once.
  local groups=() seen=" " g
  for c in "${commands[@]}"; do
    g=$(group_of "$c")
    [[ "$c" == *-* ]] || continue
    [[ "$seen" == *" $g "* ]] && continue
    if is_group "$g"; then
      groups+=("$g")
      seen+="$g "
    fi
  done

  # Grouped commands first.
  for g in "${groups[@]}"; do
    printf '%s%s%s\n' "$C_CYAN$C_BOLD" "$g" "$C_RESET"
    for c in "${commands[@]}"; do
      [[ "$c" == "$g-"* ]] || continue
      printf '  %-22s %s%s%s\n' "${c#"$g"-}" "$C_DIM" "$(describe "$c")" "$C_RESET"
    done
    printf '\n'
  done

  # Then everything that is not part of a group.
  local ungrouped=()
  for c in "${commands[@]}"; do
    g=$(group_of "$c")
    if [[ "$c" == *-* ]] && [[ "$seen" == *" $g "* ]]; then
      continue
    fi
    ungrouped+=("$c")
  done

  if [[ ${#ungrouped[@]} -gt 0 ]]; then
    printf '%scommands%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
    for c in "${ungrouped[@]}"; do
      printf '  %-22s %s%s%s\n' "$c" "$C_DIM" "$(describe "$c")" "$C_RESET"
    done
    printf '\n'
  fi

  printf '%sAny command accepts --help.%s\n' "$C_DIM" "$C_RESET"
}

# -------------------------------------------------------------- suggestion ---

# Nearest match by longest shared prefix. Cheap, and right nearly every time
# for the way people actually mistype these ('docter', 'them apply').
suggest() {
  local input=$1 best="" best_len=0 c i len
  while IFS= read -r c; do
    len=0
    for ((i = 0; i < ${#input} && i < ${#c}; i++)); do
      [[ "${input:i:1}" == "${c:i:1}" ]] || break
      len=$((len + 1))
    done
    if [[ $len -gt $best_len ]]; then
      best_len=$len
      best=$c
    fi
  done < <(discover_commands)

  [[ $best_len -ge 2 ]] && printf '%s' "$best"
}

# ----------------------------------------------------------------- dispatch ---

main() {
  if [[ $# -eq 0 ]]; then
    print_help
    exit 0
  fi

  case "$1" in
    -h|--help|help)
      print_help
      exit 0
      ;;
    -v|--version)
      exec "$BIN_DIR/monarch-version" "${@:2}"
      ;;
  esac

  # Longest match wins: 'monarch theme apply x' resolves to monarch-theme-apply
  # with 'x' as its argument, not monarch-theme with 'apply x'.
  local n
  for n in 2 1; do
    [[ $# -ge $n ]] || continue
    local parts=("${@:1:n}")
    local candidate="$BIN_DIR/monarch-$(IFS=-; printf '%s' "${parts[*]}")"
    if [[ -f "$candidate" && -x "$candidate" ]]; then
      exec "$candidate" "${@:n+1}"
    fi
  done

  local attempted; attempted=$(IFS=-; printf '%s' "$*")
  err "unknown command: monarch $*"

  local guess; guess=$(suggest "$attempted")
  if [[ -n "$guess" ]]; then
    printf '\nDid you mean:  %smonarch %s%s\n' \
      "$C_BOLD" "${guess//-/ }" "$C_RESET" >&2
  fi
  printf "\nRun 'monarch' with no arguments to see everything available.\n" >&2
  exit 1
}

main "$@"
