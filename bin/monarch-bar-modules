#!/usr/bin/env bash
#DESC: Turn individual Waybar modules on and off

set -euo pipefail

_src=${BASH_SOURCE[0]}
while [[ -L "$_src" ]]; do
  _dir=$(cd -P "$(dirname "$_src")" && pwd); _src=$(readlink "$_src")
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
MONARCH_HOME=${MONARCH_HOME:-$(cd -P "$(dirname "$_src")/.." && pwd)}
# shellcheck source=/dev/null
source "$MONARCH_HOME/bin/_lib.sh"

usage() {
  cat <<'EOF'
Choose which modules the bar shows, and in what order.

Usage:
  monarch bar modules                      what is on and what is off
  monarch bar modules enable <name>...
  monarch bar modules disable <name>...
  monarch bar modules order <name>...      set the whole right-hand group
  monarch bar modules reset                back to the shipped set
  monarch bar modules --performance        CPU and RAM only, polled at 10s
  monarch bar modules --standard           the full set again

Short names are accepted: gpu, netio, net, audio, bt.

How it works

  settings.toml holds bar_modules — the right-hand group, in order. This
  command edits that and regenerates ~/.config/waybar/modules-enabled.jsonc,
  which config.jsonc includes. Waybar is then restarted, because it has no way
  to reload a changed module list.

  The definitions themselves live in config/waybar/modules-system.jsonc and are
  not affected: a module that is off is defined but not placed, which costs
  nothing.
EOF
}

SETTINGS="$MONARCH_CONFIG_DIR/monarch/settings.toml"
WAYBAR_DIR="$MONARCH_CONFIG_DIR/waybar"
ENABLED_OUT="$WAYBAR_DIR/modules-enabled.jsonc"
ACTIVE_LINK="$WAYBAR_DIR/modules-active.jsonc"

# What ships. `reset` goes back to this, and it is the fallback when
# settings.toml has no bar_modules key yet.
DEFAULT_MODULES=(
  custom/update
  cpu memory custom/gpu network#throughput disk
  tray bluetooth network wireplumber battery clock
)

# Typing 'custom/gpu' and 'network#throughput' at a shell is unpleasant —
# '#' starts a comment unless quoted, which is a trap worth removing.
expand_alias() {
  case "$1" in
    gpu)             printf 'custom/gpu' ;;
    update|updates)  printf 'custom/update' ;;
    netio|net-io|throughput) printf 'network#throughput' ;;
    net)             printf 'network' ;;
    audio|volume)    printf 'wireplumber' ;;
    bt)              printf 'bluetooth' ;;
    ram|mem)         printf 'memory' ;;
    *)               printf '%s' "$1" ;;
  esac
}

# ---------------------------------------------------------------- settings ---

# bar_modules is deliberately kept on ONE line in settings.toml. A single-line
# array is something sed and awk can rewrite without a TOML writer, and this is
# the only place MonARCH edits an array in place.
read_modules() {
  local line
  if [[ -f "$SETTINGS" ]]; then
    line=$(sed -n 's/^[[:space:]]*bar_modules[[:space:]]*=[[:space:]]*\[\(.*\)\].*/\1/p' \
      "$SETTINGS" | head -n1)
  fi

  if [[ -z "${line:-}" ]]; then
    printf '%s\n' "${DEFAULT_MODULES[@]}"
    return 0
  fi

  # "a", "b", "c"  ->  one per line
  printf '%s' "$line" | tr ',' '\n' | sed 's/[[:space:]"]//g' | grep -v '^$' || true
}

write_modules() {
  local mods=("$@") joined="" m tmp

  for m in "${mods[@]}"; do
    [[ -n "$joined" ]] && joined+=", "
    joined+="\"$m\""
  done

  [[ -f "$SETTINGS" ]] || { warn "no settings.toml — not recording the module list"; return 0; }

  tmp=$(mktemp)
  if grep -q '^[[:space:]]*bar_modules[[:space:]]*=' "$SETTINGS"; then
    awk -v v="bar_modules = [$joined]" '
      !done && /^[[:space:]]*bar_modules[[:space:]]*=/ { print v; done = 1; next }
      { print }
    ' "$SETTINGS" >"$tmp"
  else
    # Append with the comment it deserves, rather than a bare line someone
    # later has to work out the meaning of.
    cp "$SETTINGS" "$tmp"
    {
      printf '\n# The right-hand group of the bar, in order. Managed by:\n'
      printf '#   monarch bar modules enable|disable|order|reset\n'
      printf '# Kept on one line so the CLI can rewrite it without a TOML writer.\n'
      printf 'bar_modules = [%s]\n' "$joined"
    } >>"$tmp"
  fi
  cat "$tmp" >"$SETTINGS"
  rm -f "$tmp"
}

# -------------------------------------------------------------- generation ---

render_enabled() {
  local mods=("$@") m

  printf '// GENERATED BY MONARCH — DO NOT EDIT\n'
  printf '//\n'
  printf '// Regenerate with: monarch bar modules\n'
  printf '//\n'
  printf '// Which modules the bar places, and in what order. The definitions are in\n'
  printf '// modules-active.jsonc and in config.jsonc; this file only decides placement.\n'
  printf '{\n'
  printf '  "modules-right": [\n'
  local last=$(( ${#mods[@]} - 1 )) i
  for i in "${!mods[@]}"; do
    m=${mods[i]}
    if [[ $i -eq $last ]]; then
      printf '    "%s"\n' "$m"
    else
      printf '    "%s",\n' "$m"
    fi
  done
  printf '  ]\n'
  printf '}\n'
}

# modules-active.jsonc is a symlink to whichever variant is in use. config.jsonc
# includes the stable name, so switching variants never edits a shipped file —
# and because it is a symlink rather than a copy, an update to the variant flows
# through without needing this command run again.
#
# It points into ~/.config, NOT into the repo. monarch-config-apply deploys both
# variants there, and a link to the repo would quietly bypass that copy: a file
# the user had edited would have no effect, which is exactly the surprise the
# whole deploy mechanism exists to avoid.
link_variant() {
  local variant=$1 name="modules-system.jsonc"
  [[ "$variant" == "performance" ]] && name="modules-system-performance.jsonc"

  local target="$WAYBAR_DIR/$name"

  # config apply has not run yet during a first install, so fall back to the
  # repo copy rather than leaving a dangling link.
  if [[ ! -f "$target" ]]; then
    local shipped="$MONARCH_HOME/config/waybar/$name"
    [[ -f "$shipped" ]] || die "missing $name in both ~/.config/waybar and the repo"
    target=$shipped
  fi

  mkdir -p "$WAYBAR_DIR"
  ln -sfn "$target" "$ACTIVE_LINK"
}

current_variant() {
  if [[ -L "$ACTIVE_LINK" ]] && [[ "$(readlink "$ACTIVE_LINK")" == *performance* ]]; then
    printf 'performance'
  else
    printf 'standard'
  fi
}

restart_waybar() {
  # Waybar re-reads its config on SIGUSR2, but a changed module LIST is not
  # something it picks up that way — the widgets are built at start-up. So this
  # is a restart, not a reload, and it is why the module list is not something
  # to change in a loop.
  have waybar || return 0
  pgrep -x waybar >/dev/null 2>&1 || return 0

  pkill -x waybar || true
  # Hyprland's exec-once has already run, so relaunch it directly. Disowned so
  # it does not die with this shell.
  setsid waybar >/dev/null 2>&1 &
  disown 2>/dev/null || true
  step "restarted waybar"
}

apply() {
  local mods=("$@")
  mkdir -p "$WAYBAR_DIR"

  local rendered; rendered=$(render_enabled "${mods[@]}")
  if [[ -f "$ENABLED_OUT" ]] && [[ "$(<"$ENABLED_OUT")" == "$rendered" ]]; then
    ok "${#mods[@]} modules, already current"
    return 0
  fi

  local tmp="$ENABLED_OUT.monarch-tmp"
  printf '%s\n' "$rendered" >"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$ENABLED_OUT"

  ok "${#mods[@]} modules -> ${ENABLED_OUT/#$HOME/\~}"
  restart_waybar
}

show() {
  local enabled=() m
  while IFS= read -r m; do enabled+=("$m"); done < <(read_modules)

  printf '%sBar modules%s  %s(%s variant)%s\n\n' \
    "$C_BOLD" "$C_RESET" "$C_DIM" "$(current_variant)" "$C_RESET"

  printf '%son, in bar order%s\n' "$C_BOLD" "$C_RESET"
  for m in "${enabled[@]}"; do
    printf '  %s%s%s %s\n' "$C_GREEN" "on " "$C_RESET" "$m"
  done

  local off=() d found
  for d in "${DEFAULT_MODULES[@]}"; do
    found=false
    for m in "${enabled[@]}"; do [[ "$m" == "$d" ]] && { found=true; break; }; done
    [[ "$found" == false ]] && off+=("$d")
  done

  if [[ ${#off[@]} -gt 0 ]]; then
    printf '\n%soff%s\n' "$C_BOLD" "$C_RESET"
    for m in "${off[@]}"; do
      printf '  %s%s%s %s\n' "$C_DIM" "off" "$C_RESET" "$m"
    done
  fi

  printf '\n%smonarch bar modules enable|disable <name>%s\n' "$C_DIM" "$C_RESET"
}

# -------------------------------------------------------------------- main ---

main() {
  local action="" names=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)     usage; exit 0 ;;
      --performance) action="variant-performance" ;;
      --standard)    action="variant-standard" ;;
      enable|disable|order|reset)
        [[ -z "$action" ]] || die "one action at a time"
        action=$1
        ;;
      -*) err "unknown option: $1"; exit 1 ;;
      *)  names+=("$(expand_alias "$1")") ;;
    esac
    shift
  done

  local enabled=() m
  while IFS= read -r m; do enabled+=("$m"); done < <(read_modules)

  case "$action" in
    "")
      show
      ;;

    enable)
      [[ ${#names[@]} -gt 0 ]] || die "enable what?"
      for m in "${names[@]}"; do
        local found=false e
        for e in "${enabled[@]}"; do [[ "$e" == "$m" ]] && { found=true; break; }; done
        if [[ "$found" == true ]]; then
          step "$m is already on"
        else
          # New modules go to the front of the group: the stats belong left of
          # the tray and clock, and that is where anything being switched on
          # is most likely wanted.
          enabled=("$m" "${enabled[@]}")
          step "on  $m"
        fi
      done
      write_modules "${enabled[@]}"
      apply "${enabled[@]}"
      ;;

    disable)
      [[ ${#names[@]} -gt 0 ]] || die "disable what?"
      for m in "${names[@]}"; do
        local kept=() e removed=false
        for e in "${enabled[@]}"; do
          if [[ "$e" == "$m" ]]; then removed=true; else kept+=("$e"); fi
        done
        if [[ "$removed" == true ]]; then
          enabled=("${kept[@]}")
          step "off $m"
        else
          step "$m is already off"
        fi
      done
      [[ ${#enabled[@]} -gt 0 ]] || die "that would empty the bar — refusing"
      write_modules "${enabled[@]}"
      apply "${enabled[@]}"
      ;;

    order)
      [[ ${#names[@]} -gt 0 ]] || die "order needs the full list"
      write_modules "${names[@]}"
      apply "${names[@]}"
      ;;

    reset)
      link_variant standard
      write_modules "${DEFAULT_MODULES[@]}"
      apply "${DEFAULT_MODULES[@]}"
      ;;

    variant-performance)
      link_variant performance
      # CPU and RAM only — the other three have no definition in that variant,
      # and placing a module Waybar cannot find is how you get an empty bar.
      local perf=(cpu memory)
      for m in "${enabled[@]}"; do
        case "$m" in
          cpu|memory|custom/gpu|network#throughput|disk) ;;
          custom/update) perf+=("$m") ;;
          *) perf+=("$m") ;;
        esac
      done
      write_modules "${perf[@]}"
      apply "${perf[@]}"
      info "performance variant: CPU and RAM only, polled at 10s"
      ;;

    variant-standard)
      link_variant standard
      write_modules "${DEFAULT_MODULES[@]}"
      apply "${DEFAULT_MODULES[@]}"
      info "standard variant: the full set"
      ;;
  esac
}

main "$@"
